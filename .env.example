# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API URL
NEXT_PUBLIC_API_URL=https://your-backend.railway.app

# Environment
NODE_ENV=production
NEXT_PUBLIC_ENV=production

