# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API URL (public; used when BACKEND_URL_INTERNAL is not set).
# Any one of NEXT_PUBLIC_API_URL, NEXT_PUBLIC_BACKEND_URL, BACKEND_URL works.
NEXT_PUBLIC_API_URL=https://your-backend.railway.app
# Optional: private URL for BFF→backend on Railway. Reduces latency and egress.
# BACKEND_URL_INTERNAL=http://backend.railway.internal:5000

# Optional: the upload proxy (cloudflare/upload-proxy) and the media origin for the CSP
# NEXT_PUBLIC_UPLOAD_PROXY_URL=https://upload.example.com
# NEXT_PUBLIC_MEDIA_UPLOAD_ORIGIN=https://media.example.com

# Server-only: shared secret for /api/internal/emails/*
# EMAIL_RENDER_SECRET=...

# Environment
NODE_ENV=production
NEXT_PUBLIC_ENV=production

# Note: Never commit .env.local to git
# Copy this file to .env.local and fill in your values
