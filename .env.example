# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: for admin user page to auto-assign email from Auth (server-side only)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend API URL (public; used when BACKEND_URL_INTERNAL is not set)
NEXT_PUBLIC_API_URL=https://your-backend.railway.app
# Optional: private URL for BFF→backend on Railway (e.g. http://backend.railway.internal:PORT). Reduces latency and egress.
# BACKEND_URL_INTERNAL=http://backend.railway.internal:5000

# Environment
NODE_ENV=production
NEXT_PUBLIC_ENV=production

# Note: Never commit .env.local to git
# Copy this file to .env.local and fill in your values
