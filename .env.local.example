# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Flask Backend API (omit or leave empty to use built-in homework mock)
NEXT_PUBLIC_API_URL=https://your-railway-backend.railway.app

# Optional: force homework mock even when API URL is set (BFF returns stub JSON for /api/homework/*)
# MOCK_HOMEWORK_BACKEND=1

# Environment
NEXT_PUBLIC_ENV=development

# Stripe (server) — credit checkout at /api/stripe/checkout
STRIPE_SECRET_KEY=sk_live_or_test_...

# Preferred: JSON map of Stripe Price API id → credits (server-only; same account/mode as STRIPE_SECRET_KEY).
# Example: {"price_xxx":25,"price_yyy":50,"price_zzz":100}
# STRIPE_CHECKOUT_PRICE_CREDITS_JSON={"price_xxx":25}

# Optional fallback Price API IDs if STRIPE_CHECKOUT_PRICE_CREDITS_JSON is unset:
# NEXT_PUBLIC_STRIPE_PRICE_STARTER=price_...
# NEXT_PUBLIC_STRIPE_PRICE_STANDARD=price_...
# NEXT_PUBLIC_STRIPE_PRICE_PREMIUM=price_...

# Optional: canonical site URL for Stripe success/cancel redirects (else inferred from request)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Supabase service-role key — server-side only (admin API routes, never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
