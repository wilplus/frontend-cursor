# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend (Railway). Any one of these (first wins): NEXT_PUBLIC_API_URL, NEXT_PUBLIC_BACKEND_URL, BACKEND_URL.
NEXT_PUBLIC_API_URL=https://your-railway-backend.railway.app
# NEXT_PUBLIC_BACKEND_URL=https://your-railway-backend.railway.app
# BACKEND_URL=https://your-railway-backend.railway.app

# Environment
NEXT_PUBLIC_ENV=development

# Optional: BFF debug headers
# NEXT_PUBLIC_BFF_DEBUG=1
